<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>awake</id>
    <title>Awake</title>
    <version>1.5.0</version>
    <authors>Ethan Bell, Gerald Degeneve</authors>
    <owners>Ethan Bell</owners>
    <summary>Tool to prevent sleep.</summary>
    <description>Awake is a tool, that resides in system tray and prevents the computer from entering the idle state, thus successfully preventing it from automatically entering sleep/hibernation/the lock screen.</description>
	<copyright>2026 Ethan Bell, 2018 Gerald Degeneve</copyright>
    <projectUrl>https://github.com/ebell451/Awake</projectUrl>
	<licenseUrl>https://github.com/ebell451/Awake/blob/master/LICENSE</licenseUrl>
	<projectSourceUrl>https://github.com/ebell451/Awake/tree/master/src</projectSourceUrl>
	<packageSourceUrl>https://github.com/ebell451/Awake/tree/master/deploy</packageSourceUrl>
	<tags>sleep hibernate lock idle screensaver</tags>
    <iconUrl>https://github.com/ebell451/Awake/blob/master/img/icon.png</iconUrl>
    <releaseNotes>New project home.</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
	<file src="..\bin\Release\Awake.exe" target="tools" />
	<file src="..\LICENSE" target="tools" />
	<file src="..\VERIFICATION.md" target="tools" />
  </files>
</package>
